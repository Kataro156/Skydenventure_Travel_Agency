<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Skydenventures Travel</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--plum:#5f0f6b;--berry:#a0157a;--pink:#ff5fc0;--blush:#ff8fef;--cream:#fdf0f6;--ink:#2a0a2e;--card:#fff;--line:#f0cfe3;--mute:#7a5a80;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--cream:#1d0a21;--ink:#fbe8f5;--card:#2c1131;--line:#4a1d51;--mute:#c9a3cf}}
:root[data-theme="dark"]{--cream:#1d0a21;--ink:#fbe8f5;--card:#2c1131;--line:#4a1d51;--mute:#c9a3cf}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif;line-height:1.5}
h1,h2,h3{font-family:'Baloo 2',system-ui,sans-serif;line-height:1.1;margin:0}
button,input,textarea,select{font:inherit}
.btn{border:0;border-radius:999px;padding:.8rem 1.5rem;font-weight:700;cursor:pointer;background:var(--berry);color:#fff;transition:transform .15s,background .15s}
.btn:hover{background:var(--plum);transform:translateY(-1px)}
.btn.alt{background:transparent;color:var(--berry);box-shadow:inset 0 0 0 2px var(--berry)}
.btn.alt:hover{background:var(--berry);color:#fff}
.btn.sm{padding:.45rem 1rem;font-size:.85rem}
:focus-visible{outline:3px solid var(--pink);outline-offset:2px}
.hide{display:none!important}
/* welcome */
#welcome,#login{min-height:100vh;display:grid;place-items:center;padding:1.5rem;background:radial-gradient(circle at 20% 10%,var(--blush) 0,transparent 45%),radial-gradient(circle at 90% 90%,var(--pink) 0,transparent 40%),var(--cream)}
.panel{background:var(--card);border-radius:28px;padding:2.2rem;max-width:440px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(95,15,107,.22)}
.panel img{width:190px;max-width:60%;border-radius:50%;margin-bottom:.5rem;animation:rise .9s ease-out}
@keyframes rise{from{opacity:0;transform:translateY(24px) scale(.9)}}
@media (prefers-reduced-motion:reduce){.panel img{animation:none}}
.panel h1{font-size:2rem;color:var(--plum)}.panel p{color:var(--mute);margin:.4rem 0 1.4rem}
.stack{display:grid;gap:.8rem}
label{display:block;text-align:left;font-weight:700;font-size:.9rem;margin:.9rem 0 .3rem}
input,textarea,select{width:100%;padding:.7rem .9rem;border:2px solid var(--line);border-radius:14px;background:var(--cream);color:var(--ink)}
input:focus,textarea:focus,select:focus{border-color:var(--berry);outline:0}
.hint{background:var(--cream);border:2px dashed var(--pink);border-radius:14px;padding:.7rem;margin-top:1rem;font-size:.85rem;text-align:left;color:var(--mute)}
.err{color:#c0123f;font-weight:700;font-size:.9rem;margin-top:.6rem;min-height:1.3em}
.link{background:none;border:0;color:var(--berry);font-weight:700;cursor:pointer;margin-top:1rem}
/* nav */
.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:.8rem;padding:.6rem 1.2rem;padding-top:calc(.6rem + env(safe-area-inset-top,0px));background:var(--plum);color:#fff}
.top img{width:44px;height:44px;border-radius:50%}.top b{font-family:'Baloo 2';font-size:1.25rem;flex:1}
.top .badge{background:var(--pink);color:var(--plum);padding:.15rem .7rem;border-radius:99px;font-size:.8rem;font-weight:700}
.top .btn{background:#fff;color:var(--plum)}
/* guest */
.hero{padding:3.5rem 1.2rem 5rem;color:#fff;background:linear-gradient(180deg,#ff8fef 0,#e24bc0 55%,#a82aa8 100%);position:relative;overflow:hidden}
.hero .in{max-width:1000px;margin:0 auto;position:relative;z-index:1}
.hero h1{font-size:clamp(2.4rem,7vw,4.6rem);max-width:12ch}.hero p{max-width:46ch;font-size:1.1rem}
.hero svg{position:absolute;right:0;bottom:0;width:min(560px,90%);opacity:.9}
.wrap{max-width:1000px;margin:0 auto;padding:2rem 1.2rem 4rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.4rem}
.card{background:var(--card);border-radius:22px;overflow:hidden;box-shadow:0 8px 28px rgba(95,15,107,.12);display:flex;flex-direction:column}
.art{height:150px;position:relative}.art svg{width:100%;height:100%;display:block}
.art .tag{position:absolute;top:.8rem;left:.8rem;background:#fff;color:var(--berry);font-size:.78rem;font-weight:700;padding:.15rem .7rem;border-radius:99px}
.card .b{padding:1.1rem;display:flex;flex-direction:column;gap:.4rem;flex:1}
.card h3{font-size:1.3rem;color:var(--plum)}.card .meta{color:var(--mute);font-size:.88rem}
.card .row{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:.6rem}
.price{font-family:'Baloo 2';font-size:1.4rem;color:var(--berry);font-weight:800}
.card.draft{opacity:.6}
.empty{padding:3rem;text-align:center;color:var(--mute)}
h2.sec{font-size:2rem;color:var(--plum);margin-bottom:1.2rem}
:root[data-theme="dark"] h2.sec,:root[data-theme="dark"] .card h3{color:var(--blush)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) h2.sec,:root:not([data-theme="light"]) .card h3{color:var(--blush)}}
footer{text-align:center;padding:2rem;background:var(--plum);color:#fff;font-size:.9rem}
/* mod */
.mod{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 66px)}
.side{background:var(--card);border-right:2px solid var(--line);padding:1.2rem;display:flex;flex-direction:column;gap:.4rem}
.side button{text-align:left;background:none;border:0;padding:.7rem 1rem;border-radius:14px;font-weight:700;color:var(--mute);cursor:pointer}
.side button.on,.side button:hover{background:var(--berry);color:#fff}
.main{padding:1.5rem;max-width:960px;width:100%}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem}
.stat{background:var(--card);border-radius:18px;padding:1rem 1.2rem;border-left:6px solid var(--pink)}
.stat b{font-family:'Baloo 2';font-size:2rem;color:var(--berry);display:block;line-height:1}
.list{display:grid;gap:.8rem}
.item{display:flex;gap:1rem;align-items:center;background:var(--card);border-radius:18px;padding:.8rem 1rem;flex-wrap:wrap}
.item .art{width:90px;height:64px;border-radius:12px;overflow:hidden;flex:none}
.item .t{flex:1;min-width:150px}.item .t b{display:block}.item .t span{color:var(--mute);font-size:.85rem}
.pill{padding:.15rem .7rem;border-radius:99px;font-size:.78rem;font-weight:700}
.pill.live{background:#d8f8e6;color:#0c6b3a}.pill.dr{background:#fde7c8;color:#8a4b00}
.form{background:var(--card);border-radius:22px;padding:1.5rem;display:grid;grid-template-columns:1fr 1fr;gap:0 1rem}
.form .full{grid-column:1/-1}.form .acts{grid-column:1/-1;display:flex;gap:.8rem;margin-top:1.2rem}
.toast{position:fixed;bottom:calc(1.2rem + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--plum);color:#fff;padding:.7rem 1.4rem;border-radius:99px;font-weight:700;z-index:9;box-shadow:0 8px 24px rgba(0,0,0,.3)}
@media(max-width:760px){.mod{grid-template-columns:1fr}.side{flex-direction:row;overflow-x:auto;border-right:0;border-bottom:2px solid var(--line)}.side button{white-space:nowrap}.stats{grid-template-columns:1fr}.form{grid-template-columns:1fr}}

.slider{position:relative;height:clamp(320px,55vw,520px);overflow:hidden;color:#fff;background:var(--plum)}
.slider::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(60,5,70,.8),transparent 65%);z-index:1}
.sl{position:absolute;inset:0;opacity:0;transition:opacity .9s}.sl.on{opacity:1}.sl svg,.sl img{width:100%;height:100%;object-fit:cover;display:block}
.cap{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:1.5rem 1.2rem 3.2rem;max-width:1000px;margin:0 auto}
.cap h1{font-size:clamp(2rem,6vw,3.8rem);max-width:16ch}.cap p{max-width:46ch;font-size:1.1rem;margin:.5rem 0 0}
.dots{position:absolute;bottom:1.1rem;left:0;right:0;z-index:3;display:flex;gap:.5rem;justify-content:center}
.dots button{width:12px;height:12px;border-radius:50%;border:0;background:#fff;opacity:.5;cursor:pointer;padding:0;transition:width .3s,opacity .3s}
.dots button.on{opacity:1;width:32px;border-radius:99px;background:var(--pink)}
.grid{align-items:start}.card{cursor:pointer}.card .more{display:none;border-top:2px dashed var(--line);margin-top:.5rem;padding-top:.7rem;font-size:.92rem}
.card.open .more{display:block}.card .hint2{color:var(--berry);font-size:.82rem;font-weight:700}
dialog{border:0;border-radius:24px;padding:1.6rem;max-width:480px;width:calc(100% - 2rem);background:var(--card);color:var(--ink);box-shadow:0 24px 70px rgba(60,5,70,.4)}
dialog::backdrop{background:rgba(60,5,70,.55)}dialog h2{color:var(--berry);font-size:1.7rem}
.g3{display:grid;grid-template-columns:1fr 1fr 70px;gap:0 .7rem}.g3 label{margin-top:.9rem}
.thumb{width:100%;max-height:180px;object-fit:cover;border-radius:14px;margin-top:.5rem}
.ed .item{align-items:flex-start}.ed .item .art{width:150px;height:84px}.ed input{margin-top:.3rem}
.fbtn{display:inline-block;cursor:pointer}.fbtn input{display:none}
</style></head><body>

<section id="welcome"><div class="panel">
<img src="data:image/png;base64," alt="Skydenventures Travel logo">
<h1>Welcome aboard</h1><p>Browse our latest trips and travel offers, or sign in to manage the vlog.</p>
<div class="stack"><button class="btn" id="toGuest">Continue as guest</button><button class="btn alt" id="toMod">Moderator login</button></div>
</div></section>

<section id="login" class="hide"><form class="panel" id="lf" autocomplete="off">
<img src="data:image/png;base64," alt="" style="width:110px">
<h1>Moderator login</h1><p>Sign in to edit what guests see.</p>
<label for="em">Email</label><input id="em" type="email" required placeholder="you@skydenventures.com">
<label for="pw">Password</label><input id="pw" type="password" required placeholder="Password">
<div class="err" id="er" role="alert"></div>
<button class="btn" style="width:100%;margin-top:.4rem">Sign in</button>
<div class="hint"><b>Temporary login (for testing)</b><br>Email: mod@skydenventures.com<br>Password: Sky2026!</div>
<button type="button" class="link" id="back">Back to welcome</button>
</form></section>

<section id="guest" class="hide">
<header class="top"><img src="data:image/png;base64," alt=""><b>Skydenventures Travel</b><span class="badge">Guest</span><button class="btn sm" data-out>Exit</button></header>
<div class="slider" id="slider" aria-roledescription="carousel"><div id="slides"></div><div class="cap" aria-live="polite"><h1 id="sT"></h1><p id="sP"></p></div><div class="dots" id="dots"></div></div>
<div class="wrap"><h2 class="sec">Current offers</h2><div class="grid" id="gGrid"></div></div>
<footer>Questions? Message Skydenventures Travel on Facebook to book your trip.</footer></section>

<section id="mod" class="hide">
<header class="top"><img src="data:image/png;base64," alt=""><b>Skydenventures Travel</b><span class="badge">Moderator</span><button class="btn sm" data-out>Sign out</button></header>
<div class="mod"><nav class="side"><button class="on" data-v="posts">Offers</button><button data-v="edit" id="newBtn">New offer</button><button data-v="slides">Hero slides</button><button data-v="prev">Preview as guest</button></nav>
<div class="main">
<div id="v-posts"><div class="stats"><div class="stat"><b id="s1">0</b>Total offers</div><div class="stat"><b id="s2">0</b>Visible to guests</div><div class="stat"><b id="s3">0</b>Drafts</div></div>
<h2 class="sec">Manage offers</h2><div class="list" id="mList"></div></div>
<form id="v-edit" class="hide"><h2 class="sec" id="fT">New offer</h2><div class="form">
<div class="full"><label for="f1">Title</label><input id="f1" required maxlength="60"></div>
<div><label for="f2">Destination</label><input id="f2" required></div>
<div><label for="f4">Category</label><select id="f4"><option>Beach</option><option>Mountain</option><option>City</option><option>Adventure</option></select></div>
<div><label for="f3">Duration (days)</label><input id="f3" type="number" min="1" required></div>
<div><label for="f5">Price (₱)</label><input id="f5" type="number" min="0" required></div>
<div class="full"><label for="f6">Description</label><textarea id="f6" rows="3" required></textarea></div>
<div class="full"><label for="f9">Full details (shown when a guest opens the offer)</label><textarea id="f9" rows="4" placeholder="Inclusions, itinerary, meeting point..."></textarea></div>
<div class="full"><label for="f8">Offer picture</label><label class="btn sm alt fbtn">Choose picture<input type="file" id="f8" accept="image/*"></label> <button type="button" class="btn sm alt" id="rmImg">Remove picture</button><img id="pv" class="thumb hide" alt="Selected offer picture"></div>
<div class="full"><label for="f7">Visibility</label><select id="f7"><option value="1">Published – guests can see it</option><option value="0">Draft – hidden from guests</option></select></div>
<div class="acts"><button class="btn">Save offer</button><button type="button" class="btn alt" id="cancel">Cancel</button></div></div></form>
<div id="v-slides" class="hide ed"><h2 class="sec">Hero slides</h2><p style="color:var(--mute);margin-top:-.8rem">These 5 pictures slide automatically at the top of the guest page.</p><div class="list" id="slList"></div></div>
<div id="v-prev" class="hide"><h2 class="sec">Guest preview</h2><div class="grid" id="pGrid"></div></div>
</div></div></section>

<dialog id="dlg"><form id="iq"><h2>Inquire about this trip</h2><p id="iqT" style="color:var(--mute);margin:.3rem 0 0"></p>
<div class="g3"><div><label for="i1">First name</label><input id="i1" required autocomplete="given-name"></div><div><label for="i2">Last name</label><input id="i2" required autocomplete="family-name"></div><div><label for="i3">M.I.</label><input id="i3" maxlength="1" autocomplete="off"></div></div>
<label for="i4">Email</label><input id="i4" type="email" required autocomplete="email" placeholder="you@email.com">
<label for="i5">Mobile number</label><input id="i5" type="tel" required pattern="[0-9+\s\-()]{7,16}" title="Use 7 to 16 digits, for example 0917 123 4567" autocomplete="tel" placeholder="0917 123 4567">
<div class="stack" style="grid-auto-flow:column;margin-top:1.3rem"><button class="btn">Send inquiry</button><button type="button" class="btn alt" id="iqX">Cancel</button></div></form>
<div id="iqOk" class="hide" style="text-align:center"><h2>Inquiry sent</h2><p id="iqM" style="color:var(--mute)"></p><button class="btn" id="iqC">Close</button></div></dialog>
<script>
const LOGO=document.querySelector('img').src, $=s=>document.querySelector(s);
const PAL={Beach:['#ff8fef','#ff5fc0','#a82aa8'],Mountain:['#d98bff','#a82aa8','#5f0f6b'],City:['#ff9ad5','#c2269b','#5f0f6b'],Adventure:['#ffa0e8','#e24bc0','#7a1a8a']};
let offers=[
{id:1,more:'Island hopping Tours A and C, hotel with breakfast, boat and lunch, airport transfers.\nBest months: November to May.',title:'El Nido Island Escape',place:'Palawan',cat:'Beach',days:4,price:15900,desc:'Island hopping, hidden lagoons and sunset dinners by the bay.',pub:1},
{id:2,more:'2 nights beachfront stay, sunset sailing, island transfers, free time for water sports.',title:'Boracay Sunset Weekend',place:'Aklan',cat:'Beach',days:3,price:9800,desc:'White sand, sailing at golden hour and a beachfront stay.',pub:1},
{id:3,more:'Local guide, homestay with meals, trek to viewpoints, van from Banaue town.',title:'Banaue Rice Terraces Trek',place:'Ifugao',cat:'Mountain',days:3,price:7500,desc:'Guided hikes through the terraces with a local homestay.',pub:1},
{id:4,more:'Surf lessons, island tour, Sugba Lagoon, 4 nights stay, breakfast daily.',title:'Siargao Surf and Chill',place:'Surigao del Norte',cat:'Adventure',days:5,price:18500,desc:'Surf lessons, Sugba Lagoon and island cruising.',pub:0}];
let editId=null,nid=5,curImg='';
try{const s=localStorage.getItem('sky_offers');if(s){offers=JSON.parse(s);nid=Math.max(5,...offers.map(o=>o.id+1))}}catch(e){}
const save=()=>{try{localStorage.setItem('sky_offers',JSON.stringify(offers))}catch(e){toast('Pictures are too big to keep after reload. Use smaller pictures.')}};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const art0=o=>{const p=PAL[o.cat]||PAL.Beach,g='g'+o.id;return `<div class="art"><svg viewBox="0 0 300 150" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="${g}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${p[0]}"/><stop offset="1" stop-color="${p[1]}"/></linearGradient></defs><rect width="300" height="150" fill="url(#${g})"/><circle cx="70" cy="45" r="16" fill="#fff" opacity=".6"/><path d="M0 110l60-45 50 35 40-20 80 50v25H0z" fill="${p[2]}" opacity=".85"/><path d="M200 150c20-25 60-35 100-30v30z" fill="#5f0f6b"/><path d="M250 125c-2-20-1-35 3-50" stroke="#5f0f6b" stroke-width="4" fill="none"/><path d="M253 75c-15-10-28-8-35 0 12-4 22-1 35 0zm0 0c12-12 25-12 33-4-11-3-21 0-33 4z" fill="#5f0f6b"/></svg><span class="tag">${esc(o.cat)}</span></div>`};
const art=o=>o.img?`<div class="art"><img src="${o.img}" alt="" style="width:100%;height:100%;object-fit:cover;display:block"><span class="tag">${esc(o.cat)}</span></div>`:art0(o);
const peso=n=>'₱'+Number(n).toLocaleString('en-PH');
const gcard=o=>`<article class="card" tabindex="0" aria-expanded="false" onclick="this.classList.toggle('open');this.setAttribute('aria-expanded',this.classList.contains('open'))" onkeydown="if(event.key==='Enter'){this.click()}">${art(o)}<div class="b"><h3>${esc(o.title)}</h3><div class="meta">${esc(o.place)} · ${o.days} days</div><p style="margin:.2rem 0">${esc(o.desc)}</p><div class="more"><b>About this trip</b><br>${esc(o.more||'Message us for the full itinerary and inclusions.').replace(/\n/g,'<br>')}<br><br><span class="meta">${esc(o.cat)} trip · ${o.days} days · ${peso(o.price)} per person</span></div><div class="row"><span class="hint2">Tap for details</span><span class="price">${peso(o.price)}</span></div><button class="btn sm" onclick="event.stopPropagation();inq(${o.id})">Inquire</button></div></article>`;
function render(){const pub=offers.filter(o=>o.pub),h=pub.length?pub.map(gcard).join(''):'<div class="empty">No offers right now. Check back soon.</div>';
$('#gGrid').innerHTML=h;$('#pGrid').innerHTML=h;
$('#s1').textContent=offers.length;$('#s2').textContent=pub.length;$('#s3').textContent=offers.length-pub.length;
$('#mList').innerHTML=offers.length?offers.map(o=>`<div class="item">${art(o)}<div class="t"><b>${esc(o.title)}</b><span>${esc(o.place)} · ${o.days} days · ${peso(o.price)}</span></div><span class="pill ${o.pub?'live':'dr'}">${o.pub?'Published':'Draft'}</span><button class="btn sm alt" onclick="tg(${o.id})">${o.pub?'Unpublish':'Publish'}</button><button class="btn sm alt" onclick="ed(${o.id})">Edit</button><button class="btn sm alt" onclick="del(${o.id})">Delete</button></div>`).join(''):'<div class="empty">No offers yet. Choose New offer to add one.</div>'}
function show(id){['welcome','login','guest','mod'].forEach(s=>$('#'+s).classList.toggle('hide',s!==id));scrollTo(0,0)}
function view(v){['posts','edit','slides','prev'].forEach(x=>$('#v-'+x).classList.toggle('hide',x!==v));document.querySelectorAll('.side button').forEach(b=>b.classList.toggle('on',b.dataset.v===v))}
let tt;function toast(m){document.querySelector('.toast')?.remove();const t=document.createElement('div');t.className='toast';t.textContent=m;document.body.append(t);clearTimeout(tt);tt=setTimeout(()=>t.remove(),2200)}
const tg=id=>{const o=offers.find(x=>x.id===id);o.pub=o.pub?0:1;save();render();toast(o.pub?'Published':'Unpublished')};
const del=id=>{offers=offers.filter(x=>x.id!==id);save();render();toast('Deleted')};
const ed=id=>{editId=id;const o=offers.find(x=>x.id===id);$('#fT').textContent='Edit offer';f1.value=o.title;f2.value=o.place;f4.value=o.cat;f3.value=o.days;f5.value=o.price;f6.value=o.desc;f7.value=o.pub;f9.value=o.more||'';setImg(o.img||'');view('edit')};
$('#newBtn').onclick=()=>{editId=null;$('#fT').textContent='New offer';$('#v-edit').reset();setImg('')};
$('#cancel').onclick=()=>view('posts');
$('#v-edit').onsubmit=e=>{e.preventDefault();const d={title:f1.value,place:f2.value,cat:f4.value,days:+f3.value,price:+f5.value,desc:f6.value,pub:+f7.value,more:f9.value,img:curImg};
if(editId)Object.assign(offers.find(x=>x.id===editId),d);else offers.unshift({id:nid++,...d});save();render();view('posts');toast('Saved')};
document.querySelectorAll('.side button').forEach(b=>b.addEventListener('click',()=>view(b.dataset.v)));
$('#toGuest').onclick=()=>show('guest');$('#toMod').onclick=()=>show('login');$('#back').onclick=()=>show('welcome');
document.querySelectorAll('[data-out]').forEach(b=>b.onclick=()=>{em.value=pw.value='';show('welcome')});
$('#lf').onsubmit=e=>{e.preventDefault();if(em.value.trim().toLowerCase()==='mod@skydenventures.com'&&pw.value==='Sky2026!'){$('#er').textContent='';render();view('posts');show('mod')}else $('#er').textContent='Email or password is incorrect. Check the temporary login below and try again.'};

const SC=[['#ff8fef','#ff5fc0','#a82aa8'],['#d98bff','#a82aa8','#5f0f6b'],['#ff9ad5','#c2269b','#5f0f6b'],['#ffa0e8','#e24bc0','#7a1a8a'],['#ffb0f0','#ff5fc0','#8a1a8a']];
let slides=[['Your next escape starts here','Hand-picked trips from our team. Find an offer you love and message us to book.'],['Island days, golden evenings','Beaches, lagoons and sunsets across the Philippines.'],['Climb above the clouds','Guided treks with local homestays.'],['Adventure, your way','Surf, dive and explore with people who know the way.'],['Book with people who care','Tell us where you want to go. We plan the rest.']].map(a=>({t:a[0],s:a[1],img:''}));
try{const q=localStorage.getItem('sky_slides');if(q)slides=JSON.parse(q)}catch(e){}
const saveS=()=>{try{localStorage.setItem('sky_slides',JSON.stringify(slides))}catch(e){toast('Picture is too big to keep after reload. Use a smaller one.')}};
const scene=i=>{const p=SC[i%5];return `<svg viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="s${i}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${p[0]}"/><stop offset="1" stop-color="${p[1]}"/></linearGradient></defs><rect width="800" height="400" fill="url(#s${i})"/><circle cx="${150+i*120}" cy="110" r="38" fill="#fff" opacity=".55"/><path d="M0 330l${120+i*20} -160 120 90 110 -70 190 140 170 -90 ${210-i*20} 90v70H0z" fill="${p[2]}" opacity=".8"/><path d="M450 400c80-80 250-110 350-90v90z" fill="#5f0f6b"/><path d="M640 330c-4-60-2-100 8-140" stroke="#5f0f6b" stroke-width="9" fill="none"/><path d="M648 190c-40-30-75-22-95 0 35-12 62-4 95 0zm0 0c35-35 70-35 92-12-30-8-58 0-92 12z" fill="#5f0f6b"/></svg>`};
const media=(x,i)=>x.img?`<img src="${x.img}" alt="">`:scene(i);
let cur=0,tm;
function renderSlides(){$('#slides').innerHTML=slides.map((x,i)=>`<div class="sl${i===cur?' on':''}" role="group" aria-label="Slide ${i+1} of 5">${media(x,i)}</div>`).join('');$('#dots').innerHTML=slides.map((x,i)=>`<button class="${i===cur?'on':''}" aria-label="Go to slide ${i+1}" onclick="go(${i})"></button>`).join('');$('#sT').textContent=slides[cur].t;$('#sP').textContent=slides[cur].s}
function go(i){cur=(i+5)%5;renderSlides();clearInterval(tm);tm=setInterval(()=>go(cur+1),5000)}
$('#slider').onmouseenter=()=>clearInterval(tm);$('#slider').onmouseleave=()=>go(cur);
function readImg(file,w,cb){if(!file)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,w/im.width),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',.78))};im.src=r.result};r.readAsDataURL(file)}
function setImg(u){curImg=u;$('#pv').src=u;$('#pv').classList.toggle('hide',!u);$('#f8').value=''}
$('#f8').onchange=e=>readImg(e.target.files[0],900,setImg);
$('#rmImg').onclick=()=>setImg('');
function slideEd(){$('#slList').innerHTML=slides.map((x,i)=>`<div class="item"><div class="art">${media(x,i)}</div><div class="t"><label for="st${i}" style="margin:0">Slide ${i+1} title</label><input id="st${i}" value="${esc(x.t)}" oninput="slides[${i}].t=this.value;saveS();renderSlides()"><label for="ss${i}" style="margin:.5rem 0 0">Caption</label><input id="ss${i}" value="${esc(x.s)}" oninput="slides[${i}].s=this.value;saveS();renderSlides()"><div style="margin-top:.6rem;display:flex;gap:.5rem;flex-wrap:wrap"><label class="btn sm alt fbtn" style="margin:0">Change picture<input type="file" accept="image/*" onchange="upS(${i},this)"></label><button type="button" class="btn sm alt" onclick="slides[${i}].img='';saveS();slideEd();renderSlides();toast('Default picture restored')">Use default</button></div></div></div>`).join('')}
function upS(i,el){readImg(el.files[0],1600,u=>{slides[i].img=u;saveS();slideEd();renderSlides();toast('Slide picture updated')})}
document.querySelector('[data-v="slides"]').addEventListener('click',slideEd);
let iqO=null;
function inq(id){iqO=offers.find(o=>o.id===id);$('#iq').reset();$('#iq').classList.remove('hide');$('#iqOk').classList.add('hide');$('#iqT').textContent=iqO.title+' · '+iqO.place;$('#dlg').showModal()}
$('#iqX').onclick=$('#iqC').onclick=()=>$('#dlg').close();
$('#iq').onsubmit=e=>{e.preventDefault();const mi=i3.value.trim()?' '+i3.value.trim().toUpperCase()+'.':'';$('#iq').classList.add('hide');$('#iqOk').classList.remove('hide');$('#iqM').textContent='Thanks, '+i1.value.trim()+mi+' '+i2.value.trim()+'. We will contact you at '+i4.value.trim()+' about '+iqO.title+'.'};
renderSlides();go(0);
render();
</script></body></html>
